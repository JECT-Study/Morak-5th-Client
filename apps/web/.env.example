# 복사해서 .env.local로 사용하세요.

# Spring API 주소. Next 서버(BFF)에서만 사용하며 브라우저에 노출되지 않습니다.
API_BASE_URL=http://localhost:8080

# Orval이 읽을 OpenAPI(Swagger) 명세 주소
OPENAPI_URL=http://localhost:8080/v3/api-docs

# enabled로 두면 브라우저에서 MSW 목 응답을 사용합니다.
NEXT_PUBLIC_API_MOCKING=disabled



KAKAO_REST_API_KEY=

KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/callback/kakao
# 채팅 웹소켓(STOMP) 주소. 브라우저가 백엔드에 직접 연결하므로 NEXT_PUBLIC_이 필요합니다.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# 실기기(Expo)에서 PC IP로 접속할 때 허용할 호스트. 쉼표로 여러 개. 예) 192.168.0.10
ALLOWED_DEV_ORIGINS=
