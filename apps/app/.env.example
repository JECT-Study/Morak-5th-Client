# 복사해서 .env.local로 사용하세요.
# WebView로 띄울 웹 주소. 실기기에서는 PC의 LAN IP를 사용합니다. 예) http://192.168.0.10:3000
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# AdMob 보상형 광고 단위 ID(운영 빌드). 비워 두면 광고를 쓸 수 없는 빌드로 보고 웹에 "ad" 기능을 알리지 않습니다.
# 개발 중(__DEV__)에는 구글 테스트 광고 단위를 쓰므로 비워 둬도 됩니다.
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=

# AdMob 앱 ID(빌드 시 app.config.js가 읽음). 비우면 구글 테스트 앱 ID를 씁니다.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
